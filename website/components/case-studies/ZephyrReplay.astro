      linear-gradient(var(--c), var(--c)) left top / 1.5px 14px,
      linear-gradient(var(--c), var(--c)) right top / 14px 1.5px,
      linear-gradient(var(--c), var(--c)) right top / 1.5px 14px,
      linear-gradient(var(--c), var(--c)) left bottom / 14px 1.5px,
      linear-gradient(var(--c), var(--c)) left bottom / 1.5px 14px,
      linear-gradient(var(--c), var(--c)) right bottom / 14px 1.5px,
      linear-gradient(var(--c), var(--c)) right bottom / 1.5px 14px;
    background-repeat: no-repeat;
    opacity: 0.8;
  }
  .zr[data-verdict='alert']::before { --c: var(--alert); }
  :where(.zr) :is(p, ol) { margin: 0; }
  :where(.zr) code { padding: 0; font-size: inherit; color: inherit; background: none; border: 0; }

