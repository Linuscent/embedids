---
import LegacyAnchors from './LegacyAnchors.astro';

// Starlight's skip link and table of contents target this ID.
const PAGE_TITLE_ID = '_top';
---

<h1 id={PAGE_TITLE_ID}><LegacyAnchors />{Astro.locals.starlightRoute.entry.data.title}</h1>

<style>
  h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 700;
    color: var(--sl-color-white);
  }
  /* A short signal line draws in under each page title. */
  h1::after {
    content: '';
    display: block;
    width: 3.5rem;
    height: 2px;
    margin-top: 1.1rem;
    background: var(--sl-color-text-accent);
    box-shadow: 0 0 14px var(--sl-color-text-accent);
    transform-origin: left;
    animation: title-signal 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }
  @keyframes title-signal { from { transform: scaleX(0); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    h1::after { animation: none; }
  }
</style>
