  .tile-label { grid-area: label; font-size: 0.74rem; font-weight: 600; line-height: 1.3; }
  .tile-value {
    grid-area: value;
    overflow: hidden;
    font: 400 0.66rem/1.45 var(--sl-font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tile-text { grid-area: text; font: 500 0.62rem/1.6 var(--sl-font-mono); color: var(--tone); white-space: nowrap; }

  /* Bounded queue */
  .queue { position: relative; z-index: 1; display: grid; gap: 0.35rem; justify-items: center; text-align: center; }
  .cells {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3px;
    width: 100%;
    padding: 0.4rem;
    background: rgba(10, 12, 20, 0.92);
    border: 1px solid rgba(34, 211, 238, 0.3);
    border-radius: 0.5rem;
