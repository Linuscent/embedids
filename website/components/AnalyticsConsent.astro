<analytics-consent>
  <button class="cookie-settings" type="button" data-settings>Cookie settings</button>
  <section class="consent-panel" aria-label="Analytics preferences" hidden>
    <h2>Help improve the documentation</h2>
    <p>With your permission, we use Google Analytics to understand which guides are useful. You can change your choice at any time.</p>
    <a href="https://linuscent.com/privacy-policy">Privacy &amp; cookies policy</a>
    <div class="consent-actions">
      <button type="button" data-choice="denied">Decline analytics</button>
      <button type="button" data-choice="granted">Allow analytics</button>
    </div>
  </section>
</analytics-consent>

<script>
  const key = 'embedids-analytics-consent';
  const measurementId = 'G-VMNCGL6HHQ';
  const analyticsWindow = window as typeof window & {
    dataLayer?: unknown[];
    gtag?: (...args: unknown[]) => void;
    'ga-disable-G-VMNCGL6HHQ'?: boolean;
  };
  function enableAnalytics() {
    analyticsWindow['ga-disable-G-VMNCGL6HHQ'] = false;
    if (analyticsWindow.gtag) {
      analyticsWindow.gtag('consent', 'update', { analytics_storage: 'granted' });
      return;
    }
    analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
    analyticsWindow.gtag = function () { analyticsWindow.dataLayer!.push(arguments); };
    analyticsWindow.gtag('consent', 'default', {
      analytics_storage: 'granted', ad_storage: 'denied',
      ad_user_data: 'denied', ad_personalization: 'denied',
    });
    analyticsWindow.gtag('js', new Date());
    analyticsWindow.gtag('config', measurementId);
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
    document.head.append(script);
  }
  function disableAnalytics() {
    analyticsWindow['ga-disable-G-VMNCGL6HHQ'] = true;
    analyticsWindow.gtag?.('consent', 'update', { analytics_storage: 'denied' });
    // Clear first-party GA cookies, including cookies set on the parent domain.
    const labels = location.hostname.split('.');
    const domains = ['', ...labels.map((_, i) => labels.slice(i).join('.'))];
    for (const cookie of document.cookie.split(';')) {
      const name = cookie.trim().split('=')[0];
      if (!/^_ga(?:_|$)/.test(name)) continue;
      for (const domain of domains) {
        document.cookie = `${name}=; Max-Age=0; Path=/${domain ? `; Domain=${domain}` : ''}`;
      }
    }
  }
  class AnalyticsConsent extends HTMLElement {
    connectedCallback() {
      const panel = this.querySelector<HTMLElement>('.consent-panel')!;
      const settings = this.querySelector<HTMLButtonElement>('[data-settings]')!;
      let choice: string | null = null;
      try { choice = localStorage.getItem(key); } catch { /* No consent without an explicit choice. */ }
      if (choice === 'granted') enableAnalytics();
      panel.hidden = choice === 'granted' || choice === 'denied';
      settings.addEventListener('click', () => {
        panel.hidden = false;
        panel.querySelector('button')?.focus();
      });
      this.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((button) => {
        button.addEventListener('click', () => {
          const value = button.dataset.choice!;
          try { localStorage.setItem(key, value); } catch { /* Choice still applies for this visit. */ }
          if (value === 'granted') enableAnalytics(); else disableAnalytics();
          panel.hidden = true;
          settings.focus({ preventScroll: true });
        });
      });
    }
  }
  customElements.define('analytics-consent', AnalyticsConsent);
</script>

<style>
  button { cursor: pointer; font: inherit; }
  .cookie-settings { background: none; border: 0; padding: 0.5rem 0; color: inherit; text-decoration: underline; text-underline-offset: 0.2em; }
  .consent-panel { position: fixed; z-index: 100; bottom: 1rem; inset-inline: 1rem; max-width: 42rem; margin-inline: auto; padding: 1.5rem; background: var(--sl-color-gray-6); color: var(--sl-color-gray-1); border: 1px solid var(--sl-color-gray-4); border-radius: 0.75rem; box-shadow: 0 12px 40px #0005; font-size: 0.875rem; }
  .consent-panel[hidden] { display: none; }
  h2 { font-size: 1.15rem; color: var(--sl-color-white); margin-bottom: 0.5rem; }
  p { line-height: 1.6; }
  a { color: var(--sl-color-text-accent); }
  .consent-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1rem; }
  .consent-actions button { min-height: 2.75rem; padding: 0.5rem 1rem; border: 1px solid var(--sl-color-gray-4); border-radius: 0.375rem; background: var(--sl-color-bg); color: var(--sl-color-white); }
  .consent-actions button:hover { border-color: var(--sl-color-text-accent); }
  [data-choice='granted'] { background: var(--sl-color-accent-low) !important; color: var(--sl-color-text-accent) !important; }
</style>
