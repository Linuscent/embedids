---
import Footer from '@astrojs/starlight/components/Footer.astro';
import Versions from './Versions.astro';
import AnalyticsConsent from './AnalyticsConsent.astro';
import ImageZoom from './ImageZoom.astro';
import Motion from './Motion.astro';
---
<Footer />
<div class="brand-footer">
  <a href="https://linuscent.com">Linuscent</a>
  <span>© {new Date().getFullYear()} Linuscent Ltd</span>
  <a href="https://github.com/Linuscent/EmbedIDS/blob/main/LICENSE">Apache 2.0</a>
  <Versions />
  <a href="https://github.com/Linuscent/EmbedIDS/issues/new">Report a docs issue</a>
  <AnalyticsConsent />
</div>
<ImageZoom />
<Motion />
<style>
  .brand-footer { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--sl-color-hairline); font-size: 0.8rem; color: var(--sl-color-gray-2); }
  a { color: inherit; text-underline-offset: 0.2em; }
  a:first-child { font-family: var(--brand-display); font-size: 1.1rem; font-weight: 700; color: var(--sl-color-white); }
  a:hover { color: var(--sl-color-text-accent); }
</style>
