---
/**
 * Platforms EmbedIDS has code for, each labelled with how far it has been validated.
 * Simple Icons 16.36.0 (CC0) for the monochrome marks; the Zephyr logo is the official
 * dark-background artwork from the Zephyr v4.2.0 repository (doc/_static/images).
 */
import zephyr from '../../assets/platforms/zephyr.svg';
import linux from '../../assets/platforms/linux.svg?raw';
import nvidia from '../../assets/platforms/nvidia.svg?raw';
import docker from '../../assets/platforms/docker.svg?raw';
import cmake from '../../assets/platforms/cmake.svg?raw';
import c from '../../assets/platforms/c.svg?raw';

const mark = (raw: string) =>
  raw.replace(/<title>[\s\S]*?<\/title>/, '').replace('<svg', '<svg aria-hidden="true" focusable="false"');

const platforms = [
  { name: 'Linux', status: 'Host collectors · verified', svg: mark(linux) },
  { name: 'NVIDIA Jetson', status: 'Collectors built · hardware next', svg: mark(nvidia) },
  { name: 'Docker', status: 'Demo stack · Compose', svg: mark(docker) },
  { name: 'CMake', status: 'find_package · FetchContent', svg: mark(cmake) },
  { name: 'C11', status: 'Portable core · no OS calls', svg: mark(c) },
];
const lists = ['primary', 'copy'] as const;
---

<div class="platforms" data-platforms>
  <p class="platforms-label" id="platforms-label">Runs on</p>
  <div class="platforms-viewport">
    <div class="platforms-belt">
      {
        lists.map((list) => (
          <ul class="platforms-list" {...(list === 'primary' ? { 'aria-labelledby': 'platforms-label' } : { 'aria-hidden': 'true', inert: true })}>
            <li class="platform is-featured">
              <img src={zephyr.src} width="78" height="40" alt="Zephyr" class="platform-zephyr" />
              <span class="platform-text">
                <span class="platform-name">RTOS module</span>
                <span class="platform-status">Tested on native_sim</span>
              </span>
            </li>
            {platforms.map((platform) => (
              <li class="platform">
                <Fragment set:html={platform.svg} />
                <span class="platform-text">
                  <span class="platform-name">{platform.name}</span>
                  <span class="platform-status">{platform.status}</span>
                </span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
  <button class="platforms-toggle" type="button" aria-pressed="false" aria-label="Pause the platform logos">
    <span aria-hidden="true">Pause</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-platforms]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('.platforms-toggle')!;
    const label = toggle.querySelector('span')!;
    toggle.addEventListener('click', () => {
      const paused = root.toggleAttribute('data-paused');
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.setAttribute('aria-label', paused ? 'Resume the platform logos' : 'Pause the platform logos');
      label.textContent = paused ? 'Play' : 'Pause';
    });
  });
</script>

<style>
  .platforms {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: center;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(229, 231, 235, 0.08);
  }
  .platforms-label {
    margin: 0;
    font: 500 0.72rem/1.3 var(--sl-font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(229, 231, 235, 0.6);
    white-space: nowrap;
  }
  .platforms-viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .platforms-belt {
    display: flex;
    width: max-content;
    animation: belt 46s linear infinite;
  }
  .platforms:is(:hover, :focus-within) .platforms-belt,
  .platforms[data-paused] .platforms-belt { animation-play-state: paused; }
  @keyframes belt { to { transform: translateX(-50%); } }
  .platforms-list {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    padding: 0.25rem 0.75rem 0.25rem 0;
    list-style: none;
  }

  .platform {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0.6rem 1.1rem 0.6rem 0.9rem;
    white-space: nowrap;
    background: rgba(10, 12, 20, 0.75);
    border: 1px solid rgba(229, 231, 235, 0.1);
    border-radius: 0.6rem;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }
  .platform :global(svg) {
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    fill: #e5e7eb;
    opacity: 0.85;
    transition: opacity 0.25s ease, fill 0.25s ease;
  }
  .platform:hover { border-color: rgba(34, 211, 238, 0.4); }
  .platform:hover :global(svg) { opacity: 1; fill: #22d3ee; }
  .platform-zephyr { display: block; width: auto; height: 2.5rem; }
  .platform-text { display: grid; gap: 0.1rem; }
  .platform-name { font: 600 0.95rem/1.2 var(--brand-display); letter-spacing: -0.01em; color: #e5e7eb; }
  .platform-status { font: 500 0.66rem/1.3 var(--sl-font-mono); color: rgba(229, 231, 235, 0.6); }
  .platform.is-featured {
    background: rgba(8, 46, 55, 0.6);
    border-color: rgba(34, 211, 238, 0.45);
    box-shadow: 0 0 24px -12px rgba(34, 211, 238, 0.8);
  }
  .platform.is-featured .platform-status { color: #22d3ee; }

  .platforms-toggle {
    min-width: 4.5rem;
    min-height: 2.5rem;
    padding: 0.25rem 0.75rem;
    font: 500 0.72rem/1.2 var(--sl-font-mono);
    color: #22d3ee;
    background: rgba(34, 211, 238, 0.08);
    border: 1px solid rgba(34, 211, 238, 0.3);
    border-radius: 0.375rem;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .platforms-toggle:hover { background: rgba(34, 211, 238, 0.16); }

  @media (max-width: 40rem) {
    .platforms { grid-template-columns: minmax(0, 1fr) auto; }
    .platforms-viewport { grid-column: 1 / -1; grid-row: 2; }
  }

  /* Without motion the belt becomes a wrapped list and the copy is dropped. */
  @media (prefers-reduced-motion: reduce) {
    .platforms { grid-template-columns: auto minmax(0, 1fr); }
    .platforms-belt { width: auto; animation: none; }
    .platforms-viewport { -webkit-mask-image: none; mask-image: none; }
    .platforms-list { flex-wrap: wrap; padding: 0; }
    .platforms-list[aria-hidden], .platforms-toggle { display: none; }
  }
</style>
