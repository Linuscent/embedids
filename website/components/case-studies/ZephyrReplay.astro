  .zr-out :global(.line) { font: 400 0.68rem/1.5 var(--sl-font-mono); color: var(--text); overflow-wrap: anywhere; }
  .zr-out :global(.note) { font: 500 0.64rem/1.4 var(--sl-font-mono); color: var(--muted); }
