<script>
  // Reveal homepage sections once they enter the viewport. Content is only hidden when
  // the head script has confirmed motion is allowed, and is shown again if this fails to run.
  (window as typeof window & { __revealReady?: boolean }).__revealReady = true;
  const root = document.documentElement;
  if (root.classList.contains('motion-ok')) {
    const targets = document.querySelectorAll('[data-reveal]');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    targets.forEach((target) => observer.observe(target));
  }
</script>
