---
// Default to Linuscent's dark identity while retaining Starlight's theme controls.
import ThemeProvider from '@astrojs/starlight/components/ThemeProvider.astro';
---
<script is:inline>
  try {
    if (localStorage.getItem('starlight-theme') === null) localStorage.setItem('starlight-theme', 'dark');
  } catch { /* Theme controls still work when browser storage is unavailable. */ }
</script>
<ThemeProvider />
