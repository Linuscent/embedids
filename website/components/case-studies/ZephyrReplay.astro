  figcaption { margin-top: 0.75rem; font-size: 0.74rem; line-height: 1.5; color: var(--muted); }
  figcaption code { font-family: var(--sl-font-mono); color: var(--text); }
  figcaption a { color: var(--cyan); text-underline-offset: 0.2em; }
  figcaption a:hover { color: var(--text); }

  /* Narrow screens: stack the pipeline and drop the wires. */
  @media (max-width: 44rem) {
    .zr-scenes { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .zr-scenes button, .zr-toggle { min-height: 2.75rem; }
    .zr-stage { grid-template-columns: 1fr; gap: 1rem; }
    .zr-wires { display: none; }
    .queue { grid-template-columns: auto 1fr auto; align-items: center; justify-items: start; text-align: left; column-gap: 0.75rem; }
    .queue .lane-label { grid-column: 1 / -1; }
    .cells { grid-column: 1 / -1; grid-template-columns: repeat(16, 1fr); }
    .queue-lost { grid-column: 1 / -1; }
    .zr-device .zr-muted { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-dot, .tile.flash, .rule.flash, .bump, .queue-lost, .zr-out :global(li),
    [data-tile='heartbeat'] .tile-dot, .zr-console :global(.cmd::after) { animation: none !important; }
    .cells i, .meter-fill { transition: none; }
  }
</style>
