---
import { Icon } from '@astrojs/starlight/components';
import DeviceTrustMonitor from './home/DeviceTrustMonitor.astro';
import PlatformMarquee from './home/PlatformMarquee.astro';
import LegacyAnchors from './LegacyAnchors.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const facts = ['Apache 2.0', 'C11 static library', 'No heap allocation', 'Works offline', 'Zephyr RTOS module'];
---

<section class="home-hero" aria-labelledby="_top">
  <div class="hero-backdrop" aria-hidden="true">
    <div class="hero-grid"></div>
    <div class="hero-scanlines"></div>
    <div class="hero-glow"></div>
  </div>

  <div class="hero-copy">
    <h1 id="_top" data-page-title><LegacyAnchors /><Fragment set:html={title} /></h1>
    {tagline && <p class="hero-tagline" set:html={tagline} />}
    <div class="hero-actions">
      {
        actions.map(({ link, text, icon, variant }) => (
          <a
            href={link}
            class:list={['hero-action', variant === 'primary' ? 'is-primary' : 'is-ghost']}
            data-magnetic
          >
            {text}
            {icon?.name && <Icon name={icon.name} size="1.1rem" />}
          </a>
        ))
      }
    </div>
    <ul class="hero-facts" aria-label="Library characteristics">
      {facts.map((fact) => <li>{fact}</li>)}
    </ul>
  </div>

  <div class="hero-visual">
    <DeviceTrustMonitor />
  </div>

  <div class="hero-platforms">
    <PlatformMarquee />
  </div>
</section>

<script>
  // Buttons lean towards the pointer, as on linuscent.com.
  if (matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((button) => {
      button.addEventListener('pointermove', (event) => {
        const box = button.getBoundingClientRect();
        const x = event.clientX - box.left - box.width / 2;
        const y = event.clientY - box.top - box.height / 2;
        button.style.transform = `translate(${x * 0.2}px, ${y * 0.3}px)`;
      });
      button.addEventListener('pointerleave', () => (button.style.transform = ''));
    });
  }
</script>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 3rem;
    align-items: center;
    padding-block: clamp(2.5rem, 7vh, 6rem) clamp(3rem, 9vh, 7rem);
    color: #e5e7eb;
  }

  /* Full-bleed void band behind the hero, in both colour themes. */
  .hero-backdrop {
    position: absolute;
    z-index: -1;
    inset-block: calc(-1.5rem - 1px) 0;
    inset-inline: calc(50% - 50vw);
    overflow: hidden;
    background: #05060a;
    border-bottom: 1px solid rgba(34, 211, 238, 0.12);
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(34, 211, 238, 0.07) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(34, 211, 238, 0.07) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 75% 70% at 60% 45%, #000 25%, transparent 78%);
    animation: grid-drift 28s linear infinite;
  }
  @keyframes grid-drift { to { background-position: 48px 48px; } }
  .hero-scanlines {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    background-image: repeating-linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 0 1px, transparent 1px 3px);
  }
  .hero-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(40% 45% at 75% 50%, rgba(34, 211, 238, 0.12), transparent 70%),
      radial-gradient(60% 60% at 50% 45%, transparent 45%, rgba(5, 6, 10, 0.9) 100%);
  }

  h1 {
    max-width: 15ch;
    margin: 0;
    font-family: var(--brand-display);
    font-size: clamp(2.4rem, 5.2vw, 4.75rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: #e5e7eb;
    text-shadow: 0 0 32px rgba(34, 211, 238, 0.25);
  }
  h1 :global(.accent) { color: #22d3ee; }

  .hero-tagline {
    max-width: 36rem;
    margin: 1.75rem 0 0;
    font-size: clamp(1.05rem, 1.3vw, 1.25rem);
    line-height: 1.65;
    color: rgba(229, 231, 235, 0.78);
  }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2.25rem; }
  .hero-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.9rem;
    padding: 0.75rem 1.5rem;
    border-radius: 0.375rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
  }
  .hero-action.is-primary { color: #05060a; background: #22d3ee; }
  .hero-action.is-primary:hover { background: #4ade80; }
  .hero-action.is-ghost {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    color: #e5e7eb;
    box-shadow: inset 0 0 0 1px rgba(229, 231, 235, 0.22);
  }
  .hero-action.is-ghost:hover { color: #22d3ee; box-shadow: inset 0 0 0 1px rgba(34, 211, 238, 0.55); }
  .hero-action:focus-visible { outline: 2px solid #22d3ee; outline-offset: 4px; }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    font: 500 0.78rem/1.4 'JetBrains Mono', monospace;
    color: rgba(229, 231, 235, 0.6);
  }
  .hero-facts li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .hero-facts li::before {
    content: '';
    width: 0.35rem;
    height: 0.35rem;
    background: #22d3ee;
    transform: rotate(45deg);
  }

  /* Entrance: the copy settles while the monitor powers on. */
  .hero-copy > * { animation: rise 0.8s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .hero-copy > :nth-child(2) { animation-delay: 0.08s; }
  .hero-copy > :nth-child(3) { animation-delay: 0.16s; }
  .hero-copy > :nth-child(4) { animation-delay: 0.24s; }
  .hero-visual { animation: power-on 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both; }
  .hero-platforms { grid-column: 1 / -1; min-width: 0; animation: rise 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } }
  @keyframes power-on {
    from { opacity: 0; clip-path: inset(48% 0 48% 0); filter: brightness(2.2); }
    60% { opacity: 1; clip-path: inset(0 0 0 0); }
  }

  @media (min-width: 80rem) {
    .home-hero { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2.5rem, 4vw, 5rem); min-height: calc(88vh - var(--sl-nav-height)); }
  }
  @media (max-width: 79.99rem) {
    .hero-visual { max-width: 46rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-grid, .hero-copy > *, .hero-visual, .hero-platforms { animation: none; }
  }
</style>
