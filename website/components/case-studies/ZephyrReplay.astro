  .rule-value { grid-area: value; font: 400 0.64rem/1.35 var(--sl-font-mono); font-variant-numeric: tabular-nums; color: var(--muted); white-space: nowrap; }
  .rule[data-state='alert'] .rule-value { color: #ff8a9c; }
  .meter { grid-area: meter; position: relative; height: 0.25rem; overflow: visible; border-radius: 1rem; background: rgba(229, 231, 235, 0.07); }
  .meter-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--tone);
    box-shadow: 0 0 8px color-mix(in srgb, var(--tone) 70%, transparent);
    transform-origin: left;
    transform: scaleX(var(--fill, 0));
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.3s ease;
  }
  .meter-limit { position: absolute; top: -0.2rem; bottom: -0.2rem; left: 62%; width: 1px; background: rgba(229, 231, 235, 0.45); }

  /* --- Detector output ------------------------------------------------------ */
  .zr-out {
    display: grid;
