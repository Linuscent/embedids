source "Kconfig.zephyr"

config EMBEDIDS_DEMO_FAULT_INJECTION
	bool "Enable test-only fault injection commands"
	default n
	help
	  Allows deliberately bypassing configuration writes and stopping the
	  telemetry heartbeat. Never enable in production firmware.
