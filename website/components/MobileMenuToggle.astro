---
import { Icon } from '@astrojs/starlight/components';
---
<docs-menu-toggle>
  <button type="button" aria-label="Menu" aria-expanded="false" aria-controls="starlight__sidebar">
    <Icon name="bars" />
  </button>
</docs-menu-toggle>
<script>
  class DocsMenuToggle extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button')!;
      const setOpen = (open: boolean) => {
        button.setAttribute('aria-expanded', String(open));
        // Starlight reveals the sidebar with `[aria-expanded='true'] ~ .sidebar-pane`,
        // so the state must also sit on this element, the pane's preceding sibling.
        this.setAttribute('aria-expanded', String(open));
        document.body.toggleAttribute('data-mobile-menu-expanded', open);
      };
      button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          button.focus();
        }
      });
      document.querySelectorAll('#starlight__sidebar a').forEach((link) => {
        link.addEventListener('click', () => setOpen(false));
      });
    }
  }
  customElements.define('docs-menu-toggle', DocsMenuToggle);
</script>
<style>
  button { position: fixed; top: calc((var(--sl-nav-height) - 2.75rem) / 2); inset-inline-end: var(--sl-nav-pad-x); z-index: var(--sl-z-index-navbar); display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 1px solid var(--sl-color-gray-4); border-radius: 0.375rem; background: var(--sl-color-bg); color: var(--sl-color-white); cursor: pointer; }
  button[aria-expanded='true'] { color: var(--sl-color-text-accent); background: var(--sl-color-accent-low); }
  @media (min-width: 50rem) { button { display: none; } }
</style>
