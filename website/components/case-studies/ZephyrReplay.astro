  }
  .cells i {
    height: 0.62rem;
    border-radius: 2px;
    background: rgba(229, 231, 235, 0.06);
    transition: background-color 0.25s ease calc(var(--i) * 14ms), box-shadow 0.25s ease calc(var(--i) * 14ms);
  }
  .cells i[data-on] { background: var(--cyan); box-shadow: 0 0 6px rgba(34, 211, 238, 0.6); }
  .queue[data-tone='over'] .cells { border-color: rgba(247, 77, 103, 0.6); }
  .queue[data-tone='over'] .cells i[data-on] { background: var(--alert); box-shadow: 0 0 6px rgba(247, 77, 103, 0.7); }
  .queue-meta { font: 400 0.62rem/1.35 var(--sl-font-mono); font-variant-numeric: tabular-nums; color: var(--muted); }
  .queue-drops strong { font-weight: 600; color: var(--text); }
